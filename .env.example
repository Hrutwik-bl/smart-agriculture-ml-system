# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
SESSION_SECRET=change-this-to-a-long-random-string

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Leave blank to run without DB (all data will be in-memory / rule-based only)
MONGODB_URI=

# ── OpenWeatherMap ────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=

# ── Python ML Service (FastAPI — run: uvicorn app:app in ml_service/) ─────────
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_PREDICT_PATH=/predict-crop
ML_IRRIGATION_PATH=/predict-irrigation
ML_FERTILIZER_PATH=/predict-fertilizer

# ── IoT Device Authentication ─────────────────────────────────────────────────
# Must match DEVICE_SECRET in esp32/sensor_node.ino AND raspberry_pi/.env
DEVICE_SECRET=iot-device-secret-change-in-prod

# ── Paddy Soil Moisture Thresholds ────────────────────────────────────────────
PADDY_SOIL_MOISTURE_LOW=40    # irrigate when moisture drops below this (%)
PADDY_SOIL_MOISTURE_HIGH=70   # stop / skip irrigation above this (%)

# ── Optional: Dataset paths for ML service (CSV fallbacks) ────────────────────
CROP_RECOMMENDATION_CSV_PATH=
IRRIGATION_CSV_PATH=
FERTILIZER_CSV_PATH=
SOIL_HEALTH_CSV_PATH=
CROP_PRICE_CSV_PATH=

# ── Demo / prototype mode ──────────────────────────────────────────────────────
# Set to true to skip real API calls and return hardcoded data (for UI testing)
DEMO_MODE=false
